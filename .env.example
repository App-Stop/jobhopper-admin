# Copy to .env and adjust per environment. Vite only exposes VITE_-prefixed vars to the app.

# job-hopper-backend base URL (no trailing slash)
VITE_API_URL=https://api.dev.jobhopper.theappstop.com

# Public JobHopper marketplace (linked from the admin sidebar)
VITE_MARKETPLACE_URL=http://localhost:5173
